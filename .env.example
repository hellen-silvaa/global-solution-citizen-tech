# Copie para .env (que NÃO vai para o Git) e troque os valores antes de `docker compose up`.
#   copy .env.example .env        (PowerShell/cmd)   |   cp .env.example .env   (Git Bash)
MYSQL_ROOT_PASSWORD=troque-esta-senha
# Segredo de assinatura do JWT: mínimo 32 caracteres aleatórios.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
