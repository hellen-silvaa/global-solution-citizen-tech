<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura de código com o coletor da Microsoft (instrumentação em memória, sem reescrever DLLs:
  funciona mesmo com o Controle de Aplicativo do Windows ativo).
  Uso: dotnet test -settings coverage.runsettings
  Migrações e código gerado pelo compilador ficam fora da medição.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*Oportuniza\.(Domain|Application|Infrastructure|Api)\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
            <Attributes>
              <Exclude>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
                <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
              </Exclude>
            </Attributes>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
